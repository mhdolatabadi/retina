{
  "uid": "retina-usage",
  "title": "Retina · Agent Token and Hormouz Cost",
  "tags": [
    "retina",
    "agents",
    "hormouz"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "5s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "کل توکن‌های Retina",
      "type": "stat",
      "description": "جمع توکن‌های ثبت‌شده برای اجراهای تأییدشده Retina",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "retina-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(retina_tokens_total)",
          "legendFormat": "{{role}} {{model}} {{task_type}} {{issue}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto"
      }
    },
    {
      "id": 2,
      "title": "هزینه تعرفه‌ای Hormouz (USD)",
